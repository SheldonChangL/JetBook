# JetBook 環境變數範本 —— 複製為 .env 後填入實值（.env 不入 repo）
# 所有設定僅能經 src/lib/env.ts（Zod 驗證）取得，缺漏會 fail-fast。

# --- 基本 ---
# 對外 base URL（含 protocol；反向代理後的位址）
BASE_URL=http://localhost
# proxy 對外埠
HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_USER=jetbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jetbook
# 容器內連線用 db 主機名；本機開發改 localhost
DATABASE_URL=postgresql://jetbook:change-me@db:5432/jetbook
