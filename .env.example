# JetBook 環境變數範本 —— 複製為 .env 後填入實值（.env 不入 repo）
# 所有設定僅能經 src/lib/env.ts（Zod 驗證）取得，缺漏會 fail-fast。

# --- 基本 ---
# 對外 base URL（含 protocol；反向代理後的位址）
BASE_URL=http://localhost
# proxy 對外埠
HTTP_PORT=80
# 附件上傳目錄（相對路徑以工作目錄為基準；容器內建議掛 volume，如 /data/uploads）
UPLOAD_DIR=uploads

# --- 檔案儲存 ---
# 附件儲存根目錄（相對路徑以工作目錄為基準；容器內建議掛 volume）
UPLOAD_DIR=./data/uploads
# 單檔上傳大小上限（MB）
MAX_UPLOAD_MB=50

# --- AI Provider（M2；未設定 LLM_PROVIDER 時 AI 功能關閉，系統其餘功能不受影響）---
# LLM_PROVIDER=anthropic | openai-compat
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5
#ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
#OPENAI_COMPAT_BASE_URL=http://vllm.internal:8000
#OPENAI_COMPAT_MODEL_PRIMARY=
#OPENAI_COMPAT_MODEL_LIGHT=
# Embedding（day-1 建議 local BGE-M3，1024 維；未設定＝語意索引關閉）
#EMBEDDING_BASE_URL=http://ollama.internal:11434
#EMBEDDING_MODEL=bge-m3
#EMBEDDING_DIMENSIONS=1024

# --- PostgreSQL ---
POSTGRES_USER=jetbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jetbook
# db 對本機 loopback 的埠（供 migration／整合測試）
POSTGRES_PORT=5432
# 本機 CLI（drizzle-kit）與開發連線用；web 容器內由 compose 覆寫為 db 主機名
DATABASE_URL=postgresql://jetbook:change-me@127.0.0.1:5432/jetbook
