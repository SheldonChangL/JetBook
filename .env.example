# JetBook 環境變數範本 —— 複製為 .env 後填入實值（.env 不入 repo）
# 所有設定僅能經 src/lib/env.ts（Zod 驗證）取得，缺漏會 fail-fast。

# --- 基本 ---
# 對外 base URL（含 protocol；反向代理後的位址）
BASE_URL=http://localhost
# proxy 對外埠
HTTP_PORT=80

# --- 維運指標（N-05，Prometheus /api/metrics）---
# 設定後，抓取端須帶 Authorization: Bearer <token>，否則 401；未設定則不驗（信任內網／代理層限制來源）。
#METRICS_TOKEN=

# --- 檔案儲存 ---
# 附件儲存根目錄。此預設（相對路徑，以工作目錄為基準）供本機開發用；
# docker compose 部署時 web/worker 會以環境變數覆寫為絕對路徑 /data/uploads（對齊掛載的 uploads volume），故無需在此改。
UPLOAD_DIR=./data/uploads
# 附件實體檔的儲存來源（僅 docker compose 用）。未設定＝用 named volume `uploads`
# （位於 /var/lib/docker/volumes/jetbook_uploads/_data）。要指定主機目錄改用 bind mount：
# 設為絕對路徑即可，但 bind mount 不繼承 image 的 owner，須先建目錄並 chown 給容器 UID 1001：
#   sudo mkdir -p /srv/jetbook/uploads && sudo chown -R 1001:1001 /srv/jetbook/uploads
# UPLOADS_SOURCE=/srv/jetbook/uploads
# 單檔上傳大小上限（MB）
MAX_UPLOAD_MB=50
# Office 附件轉 PDF 預覽（M4-12）：啟用時取消註解（compose 內建 gotenberg 服務）；
# 未設定＝Office 附件僅下載、PDF 預覽不受影響
# PREVIEW_CONVERTER_URL=http://gotenberg:3000
# 伺服器端圖片匯入（MCP import_attachment_from_url）的來源 host allowlist（逗號分隔）。
# 未設定＝一律拒絕匯入（預設拒絕，SSRF 防護）。列入者即允許解析到私有網段（內網 Redmine）；
# loopback／link-local（含 cloud metadata）／multicast 一律硬性封鎖，不受白名單影響。
# JETBOOK_ATTACHMENT_IMPORT_HOSTS=redmine.jet-opto.com.tw

# --- 編輯器 Embed 白名單（D-14）---
# 允許 iframe 嵌入的網域白名單（逗號分隔）；未設定＝白名單為空，所有嵌入 URL 一律退化為連結卡片。
# 由管理者以部署設定控管（12-factor：白名單即設定，不另建 org_settings 欄）。
# EMBED_ALLOWED_DOMAINS=youtube.com,youtu.be,player.vimeo.com,figma.com,docs.google.com

# --- Email／SMTP（B-05 忘記密碼）---
# 未設定 SMTP_HOST 時不寄信，改由 logger 輸出重設連結（僅供開發／CI）；生產環境務必設定。
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
# 直連 TLS（465）填 true；587 STARTTLS 填 false
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=JetBook <no-reply@jet-opto.com.tw>

# --- OIDC SSO（B-06；未設定 issuer/client 時 SSO 關閉：授權路由回 404、登入頁不顯示按鈕）---
#AUTH_OIDC_ISSUER=https://idp.example.com
#AUTH_OIDC_CLIENT_ID=
#AUTH_OIDC_CLIENT_SECRET=
# 未設定時由 BASE_URL + /api/auth/oidc/callback 推導
#AUTH_OIDC_REDIRECT_URI=http://localhost/api/auth/oidc/callback

# --- AI Provider（M2；未設定 LLM_PROVIDER 時 AI 功能關閉，系統其餘功能不受影響）---
# LLM_PROVIDER=anthropic | openai-compat
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5
#ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
#OPENAI_COMPAT_BASE_URL=http://vllm.internal:8000
#OPENAI_COMPAT_MODEL_PRIMARY=
#OPENAI_COMPAT_MODEL_LIGHT=
# Embedding（day-1 建議 local BGE-M3，1024 維；未設定＝語意索引關閉）
#EMBEDDING_BASE_URL=http://ollama.internal:11434
#EMBEDDING_MODEL=bge-m3
#EMBEDDING_DIMENSIONS=1024
# HNSW 向量檢索候選佇列（I-01，R4）：越大召回越高、越慢；須 ≥ over-fetch（40），依基準調校
#RAG_HNSW_EF_SEARCH=100

# --- PostgreSQL ---
POSTGRES_USER=jetbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jetbook
# db 對本機 loopback 的埠（供 migration／整合測試）
POSTGRES_PORT=5432
# 本機 CLI（drizzle-kit）與開發連線用；web 容器內由 compose 覆寫為 db 主機名
DATABASE_URL=postgresql://jetbook:change-me@127.0.0.1:5432/jetbook

# --- 備份（N-03；backup sidecar，皆為選填，未設用預設值）---
# 小時備份保留份數（預設 48 → 覆蓋 48 小時）
#BACKUP_HOURLY_KEEP=48
# 每日備份保留天數（預設 30）
#BACKUP_DAILY_KEEP_DAYS=30
# 備份 cron 排程（預設每小時整點）
#BACKUP_CRON_SCHEDULE=0 * * * *
